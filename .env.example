# Mod Ledger UI Environment Configuration

# API URLs (full paths including nginx proxy routes)
# DEV: Uses nginx reverse proxy paths
# PROD: Change to production domain with same paths

# Mod Ledger Backend API
# DEV: http://localhost/mod-ledger
# PROD: https://yourdomain.com/mod-ledger
VITE_MOD_LEDGER_URL=http://localhost/mod-ledger

# Astrogator's Table API (for authentication)
# DEV: http://localhost/astrogators-table
# PROD: https://yourdomain.com/astrogators-table
VITE_ASTROGATORS_TABLE_URL=http://localhost/astrogators-table
